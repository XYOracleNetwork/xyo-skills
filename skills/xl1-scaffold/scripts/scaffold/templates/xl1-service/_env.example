# Copy to .env (gitignored). Loaded at startup via `import 'dotenv/config'`
# in src/index.ts.

# Express server port. The companion React app's Vite dev server proxies
# /api/* requests here, so changing this requires a matching update to the
# `server.proxy` target in the React app's vite.config.ts.
PORT=3001

# XL1 network: __XL1_NETWORK_LABEL__ (scaffolded with
# --network=__XL1_NETWORK_ID__; src/index.ts uses __XL1_NETWORK__ from
# @xyo-network/xl1-sdk). INDEXER_FLOOR_BLOCK is per chain — capture it on this
# network when the dApp defines its own schemas (xl1-scaffold skill, "Capture
# the indexer floor block").
# INDEXER_FLOOR_BLOCK=
