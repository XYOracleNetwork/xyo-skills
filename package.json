{
  "name": "xyo-skills-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "eval": "node scripts/eval/run.mjs",
    "eval:judge-calibration": "node scripts/eval/calibrate-redirect-judge.mjs",
    "eval:smoke": "node scripts/eval/run.mjs --tag smoke --runs 1",
    "lint": "pnpm -r lint",
    "validate:skills": "node scripts/validate-skills.mjs skills",
    "test:scripts": "node --test scripts/*.test.mjs",
    "typecheck": "pnpm -r typecheck",
    "scaffold": "pnpm --filter @xyo-network/xl1-scaffold run scaffold",
    "scaffold:dev": "pnpm --filter @xyo-network/xl1-scaffold run scaffold:dev",
    "sync:claude": "node scripts/marketplace-sync/build-claude.mjs",
    "sync:codex": "node scripts/marketplace-sync/build-codex.mjs"
  },
  "engines": {
    "node": ">=26"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=26.0.0 <27.0.0"
    },
    "packageManager": {
      "name": "pnpm",
      "onFail": "error",
      "version": ">=12.0.0 <13.0.0"
    }
  }
}
